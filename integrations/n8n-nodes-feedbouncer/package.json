{
  "name": "@feedbouncer/n8n-nodes-feedbouncer",
  "version": "0.1.0",
  "description": "n8n community nodes for FeedBouncer: trigger on comment events and moderate comments.",
  "license": "MIT",
  "homepage": "https://github.com/feedbouncer/feedbouncer/tree/main/integrations/n8n-nodes-feedbouncer#readme",
  "author": {
    "name": "FeedBouncer",
    "email": "38005769+Omri-sh@users.noreply.github.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "feedbouncer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/feedbouncer/feedbouncer.git",
    "directory": "integrations/n8n-nodes-feedbouncer"
  },
  "scripts": {
    "build": "n8n-node build",
    "lint": "n8n-node lint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/FeedBouncerApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/FeedBouncer/FeedBouncer.node.js",
      "dist/nodes/FeedBouncerTrigger/FeedBouncerTrigger.node.js"
    ]
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "devDependencies": {
    "@n8n/node-cli": "0.52.6",
    "eslint": "9.39.5",
    "n8n-workflow": "2.43.5",
    "standardwebhooks": "1.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
