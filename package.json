{
  "name": "feedbouncer-monorepo",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "packageManager": "pnpm@12.3.0+sha512.d7bd39a488131de200aeec1dbc9ca58b890437f09b1f925b1bf820fdc463df01a329e3699c3d8a7bb186d5cf3f75cb68ce820c69d6b2c983525bc0821de4c529",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": ">=12.3.0 <13.0.0"
  },
  "scripts": {
    "preinstall": "node -e \"if (!/^pnpm\\//.test(process.env.npm_config_user_agent ?? '')) { console.error('Use pnpm instead of npm or yarn'); process.exit(1); }\"",
    "build": "turbo run build",
    "lint": "turbo run lint && eslint .",
    "format": "turbo run format && prettier --write \"*.{json,mjs,yaml,md}\" --ignore-unknown",
    "format:check": "turbo run format:check && prettier --check \"*.{json,mjs,yaml,md}\" --ignore-unknown",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test && pnpm run test:scripts",
    "test:scripts": "node --test \"scripts/ci/*.test.mjs\"",
    "stack:smoke": "node scripts/dev-stack/smoke.mjs",
    "stack:auth-smoke": "node scripts/dev-stack/auth-smoke.mjs",
    "db:migrate": "pnpm --dir packages/db run migrate:deploy",
    "db:rollback": "pnpm --dir packages/db run migrate:down",
    "db:migration:new": "pnpm --dir packages/db run migrate:new",
    "db:status": "pnpm --dir packages/db run migrate:status",
    "secrets": "pnpm --dir packages/secrets run --silent cli",
    "jobs": "pnpm --dir apps/worker run --silent jobs",
    "ops": "pnpm --dir apps/worker run --silent ops"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.12.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-turbo": "2.11.4",
    "prettier": "3.4.2",
    "turbo": "2.11.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3",
    "yaml": "2.9.1"
  }
}
