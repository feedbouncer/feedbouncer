# Dependencies
node_modules/

# Build output and byproducts (tsc --build, tsdown, Turborepo, Next.js)
dist/
dist-*/
*.tsbuildinfo
.turbo/
.next/
next-env.d.ts

# Test output
coverage/
test-results/
playwright-report/
tmp/

# Env files — only .env.example and .env.prod.example are committed
.env
.env.*
!.env.example
!.env.prod.example

# Logs
*.log

# System
.DS_Store
Thumbs.db

# Editor
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
# JS/TS tooling (pnpm + Turborepo monorepo). Added for this ticket —
# does not replace or affect the ignore rules above for this repo's
# existing non-JS tooling.
.pnpm-store/
npm-debug.log*
pnpm-debug.log*

# Stray npm artifacts: this repo uses pnpm (pnpm-lock.yaml); npm is blocked by a preinstall guard
package-lock.json
npm-shrinkwrap.json
