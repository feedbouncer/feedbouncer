{
  "name": "@feedbouncer/api",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "dev": "tsx watch --clear-screen=false src/main.ts",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@feedbouncer/actions": "workspace:*",
    "@feedbouncer/alerts": "workspace:*",
    "@feedbouncer/ai": "workspace:*",
    "@feedbouncer/authz": "workspace:*",
    "@feedbouncer/classifier": "workspace:*",
    "@feedbouncer/comments": "workspace:*",
    "@feedbouncer/connector-facebook": "workspace:*",
    "@feedbouncer/connector-instagram": "workspace:*",
    "@feedbouncer/connector-meta-ads": "workspace:*",
    "@feedbouncer/connectors": "workspace:*",
    "@feedbouncer/db": "workspace:*",
    "@feedbouncer/jobs": "workspace:*",
    "@feedbouncer/mailer": "workspace:*",
    "@feedbouncer/observability": "workspace:*",
    "@feedbouncer/policies": "workspace:*",
    "@feedbouncer/public-api": "workspace:*",
    "@feedbouncer/reports": "workspace:*",
    "@feedbouncer/rules": "workspace:*",
    "@feedbouncer/secrets": "workspace:*",
    "@feedbouncer/service-runtime": "workspace:*",
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-fastify": "12.1.2",
    "@zxcvbn-ts/core": "4.2.0",
    "@zxcvbn-ts/language-common": "4.1.3",
    "@zxcvbn-ts/language-en": "4.1.1",
    "better-auth": "1.7.7",
    "fastify": "5.12.5",
    "ioredis": "5.11.1",
    "ipaddr.js": "2.5.0",
    "pg": "8.23.1",
    "rate-limiter-flexible": "11.2.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15"
  }
}
