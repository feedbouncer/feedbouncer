{
  "name": "@feedbouncer/docs",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "node scripts/prepare-content.mjs && docusaurus gen-api-docs all && node scripts/stamp-generated.mjs && docusaurus build && node scripts/build-search-index.mjs",
    "start": "node scripts/prepare-content.mjs && docusaurus gen-api-docs all && node scripts/stamp-generated.mjs && docusaurus start",
    "serve": "docusaurus serve",
    "reference:write": "tsx scripts/write-reference.ts",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:site": "node scripts/check-routes.mjs && playwright test"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-client-redirects": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@mdx-js/react": "3.1.1",
    "clsx": "2.1.1",
    "docusaurus-plugin-openapi-docs": "5.2.0",
    "docusaurus-plugin-sass": "0.2.7",
    "docusaurus-theme-openapi-docs": "5.2.0",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sass": "1.105.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/tsconfig": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@feedbouncer/actions": "workspace:*",
    "@feedbouncer/moderation-contract": "workspace:*",
    "@feedbouncer/public-api": "workspace:*",
    "@feedbouncer/rules": "workspace:*",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "tsx": "4.23.15",
    "zod": "4.6.5"
  }
}
