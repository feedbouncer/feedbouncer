# FeedBouncer local development stack.
#   cp .env.example .env   then   docker compose up
# DEVELOPMENT-ONLY VALUES. Never reuse them anywhere reachable from a network.
# Passwords must be URL-safe (letters, digits, - _ .) because they are
# embedded in connection URLs.

# --- Required credentials (compose refuses to start without them) ---
POSTGRES_USER=feedbouncer
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=feedbouncer
REDIS_PASSWORD=dev-only-redis-password
# Signs session cookies. At least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Encrypts stored platform tokens. DEVELOPMENT-ONLY example key: production refuses it.
# Format: <key-id>:<base64 of 32 random bytes>[,<key-id>:<base64>...]. Generate: pnpm secrets keygen
# Rotation and backup: docs/operations/secrets.md. Back keys up SEPARATELY from database backups.
FB_ENCRYPTION_KEYS=dev-example:RiOYH93nnaej+o4hWDiBb6XqRseP2Fv5uDL8wejvLwY=
# The one key used for new encryption; every key listed above can still decrypt.
FB_ENCRYPTION_ACTIVE_KEY_ID=dev-example

# --- Environment ---
# development | test | production. Unset means production (strict: placeholders refused).
FB_ENV=development

# --- Secret files (containers) ---
# Any of DATABASE_URL, REDIS_URL, AUTH_SECRET, SMTP_URL, FB_ENCRYPTION_KEYS,
# FACEBOOK_APP_SECRET, FACEBOOK_WEBHOOK_VERIFY_TOKEN can instead be
# read from a mounted file by setting <NAME>_FILE to its absolute path (not both).
# AUTH_SECRET_FILE=/run/secrets/auth_secret
# FB_ENCRYPTION_KEYS_FILE=/run/secrets/fb_encryption_keys
# FACEBOOK_APP_SECRET_FILE=/run/secrets/facebook_app_secret
# FACEBOOK_WEBHOOK_VERIFY_TOKEN_FILE=/run/secrets/facebook_webhook_verify_token

# --- Set by compose.yaml for the local stack; set them yourself elsewhere ---
# DATABASE_URL=postgresql://user:password@host:5432/db
# REDIS_URL=redis://:password@host:6379/0
# SMTP_URL=smtp://host:25
# PUBLIC_WEB_URL=https://app.example.com
# TRUST_PROXY_HOPS=1
# PORT=3001
# HEALTH_PORT=3002
# MAIL_FROM=FeedBouncer <no-reply@example.com>

# --- Private beta (optional, api) ---
# Comma-separated emails (at most 200) allowed to sign up. Unset or empty and anyone can.
# An email with a pending invitation can always sign up. Others get a "private beta" email.
# SIGNUP_ALLOWED_EMAILS=ana@example.com,ben@example.com
# Contact address shown in that email.
# BETA_SUPPORT_EMAIL=support@example.com
# https:// link to your feedback form; with the support email it shows a notice in the web app.
# BETA_FEEDBACK_URL=https://forms.example.com/feedback

# --- Slack and email alerts (optional; setup: docs/operations/alerts.md) ---
# Unset or empty and alerts are off. Set the same list on the api and the worker.
# `email` also needs SMTP_URL and MAIL_FROM; every alert link is built from PUBLIC_WEB_URL.
# ALERT_CHANNELS=slack,email
# ALERT_MAX_PER_WORKSPACE_PER_HOUR=30  # 1-1000
# ALERT_EMAIL_MAX_PER_MINUTE=60        # 1-6000, worker, whole deployment

# --- Public REST API (/v1, authenticated with workspace API keys) ---
# Requests per minute allowed to each API key. 1-10000, default 60.
# PUBLIC_API_RATE_LIMIT_PER_MINUTE=60
# Hours a rule change proposed through the API waits for approval before it expires. 1-168, default 24.
# RULE_PROPOSAL_TTL_HOURS=24

# --- MCP server (apps/mcp; setup: docs/mcp/README.md) ---
# Read by the MCP server, which your MCP client starts; the compose stack does not use them.
# Base URL of the API. https, or http on localhost only. Default http://127.0.0.1:3001.
# FEEDBOUNCER_API_URL=http://127.0.0.1:3001
# FEEDBOUNCER_API_KEY (required) is a workspace API key, fbk_<16 characters a-z 2-7>_<43-character
# secret>. Put it in your MCP client's configuration, never in this file.

# --- Outgoing webhooks (managed through /v1/webhook-endpoints) ---
# Endpoints must resolve to public addresses. Self-hosters that deliver to an internal receiver
# list its network here, as comma-separated CIDR ranges. Empty (the default) allows none.
# WEBHOOK_ALLOWED_PRIVATE_CIDRS=10.0.0.0/8,192.168.0.0/16
# Deliveries one worker sends at once. 1-256, default 32.
# WEBHOOK_DISPATCH_CONCURRENCY=32

# --- Weekly email report (optional, worker) ---
# on|off, default off. `on` emails each workspace's owners and admins a weekly summary on Monday
# at 08:00 in the workspace's time zone; it needs SMTP_URL, MAIL_FROM and PUBLIC_WEB_URL.
# WEEKLY_REPORTS=off

# --- Facebook Pages connector (optional; setup: docs/connectors/facebook.md) ---
# Leave FACEBOOK_APP_ID unset and the connector is off. Both the api and the worker need the
# app id and secret. The secret and the verify token can be read from <NAME>_FILE instead.
# FACEBOOK_APP_ID=<numeric Meta app id>
# Replace the example values below with your Meta app's own. The secret is at least 16 characters.
# FACEBOOK_APP_SECRET=dev-only-replace-with-the-meta-app-secret
# At least 20 characters. Enter the same value in the app's Webhooks settings.
# FACEBOOK_WEBHOOK_VERIFY_TOKEN=dev-only-replace-with-a-random-token
# Graph API version, vNN.0. Default v26.0.
# FACEBOOK_GRAPH_API_VERSION=v26.0
# Instagram comments via Facebook Login, on the same Meta app.
# INSTAGRAM_CONNECTOR_ENABLED=false  # requires the FACEBOOK_* variables; setup: docs/connectors/instagram.md
# Comments on ads, read through the Page and Instagram connections. Same Meta app.
# META_ADS_CONNECTOR_ENABLED=false  # requires the FACEBOOK_* variables; setup: docs/connectors/meta-ads.md
# META_ADS_ACTIVE_STATUSES=ACTIVE   # comma-separated effective_status values that count as live
# Ad polling cadence (worker). Ranges and defaults: docs/connectors/meta-ads.md
# AD_POLL_INTERVAL_SEC=300
# AD_DISCOVERY_INTERVAL_SEC=900
# AD_RETIREMENT_GRACE_DAYS=7
# AD_POLL_MAX_SOURCES_PER_JOB=100
# AD_SOURCE_UNAVAILABLE_RETRY_SEC=21600
# AD_IG_DEEP_SCAN_INTERVAL_SEC=86400
# AD_SCHEDULER_TICK_SEC=30
# AD_SCHEDULER_MAX_CONNECTIONS_PER_TICK=500

# --- Host ports (change these if something on your machine already uses them) ---
WEB_HOST_PORT=3000
API_HOST_PORT=3001
# Only used with compose.expose-db.yaml (see below).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Dev mail inbox: http://127.0.0.1:8025
MAILPIT_UI_HOST_PORT=8025

# Interface web and API bind to on the host. Keep 127.0.0.1 unless you
# deliberately want other machines on your network to reach the stack.
FB_BIND_ADDRESS=127.0.0.1

# --- App settings ---
LOG_LEVEL=info
WORKER_CONCURRENCY=4
# Concurrent API text checks (moderation-check queue), 1-64.
# MODERATION_CHECK_CONCURRENCY=4

# --- Job queue (all optional; defaults shown; see docs/operations/job-queue.md) ---
# JOB_QUEUE_PREFIX=fb
# JOB_CONCURRENCY=2
# Per-platform override: JOB_CONCURRENCY_<PLATFORM> (e.g. JOB_CONCURRENCY_FACEBOOK); 0 turns that
# platform's consumer off. Not forwarded by compose.yaml; set it in the container environment.
# JOB_MAX_ATTEMPTS=8
# JOB_BACKOFF_BASE_MS=5000
# JOB_BACKOFF_MAX_MS=900000
# JOB_DLQ_RETENTION_DAYS=14
# JOB_DEDUP_WINDOW_DAYS=30
# Consumers per platform on the comment classification lane (0 turns them off). Keep it above
# CLASSIFIER_BRAND_MAX_IN_FLIGHT so one brand's backlog cannot hold every slot.
# JOB_CONCURRENCY_LANE_CLASSIFY=4
# Consumers per platform on the custom policy lane (0 turns them off). Keep it above
# POLICY_BRAND_MAX_IN_FLIGHT so one brand's backlog cannot hold every slot.
# JOB_CONCURRENCY_LANE_POLICY=4

# --- Comment classifier (optional; disabled unless CLASSIFIER_PROVIDER is set; worker only) ---
# Provider: openai | google | openai_compatible | none (default none).
# CLASSIFIER_PROVIDER=none
# CLASSIFIER_MODEL=
# Secret; prefer CLASSIFIER_API_KEY_FILE. Not needed for a keyless openai_compatible endpoint.
# CLASSIFIER_API_KEY=dev-only-replace-with-your-provider-key
# Required for openai_compatible; https unless loopback or CLASSIFIER_ALLOW_HTTP=true.
# CLASSIFIER_BASE_URL=
# CLASSIFIER_ALLOW_HTTP=false
# CLASSIFIER_TIMEOUT_MS=10000            # 1000..25000, per provider call
# CLASSIFIER_LANGUAGES=en,es,pt,fr,de,it,nl   # languages the model is trusted for (ISO 639 codes)
# CLASSIFIER_BRAND_MAX_IN_FLIGHT=2       # 1..16 concurrent provider calls per brand
# CLASSIFIER_MAX_WAIT_MINUTES=30         # 1..90, queue wait after which a comment is flagged for review
# Examples:
#   OpenAI:     CLASSIFIER_PROVIDER=openai     CLASSIFIER_MODEL=gpt-5-mini        CLASSIFIER_API_KEY=...
#   Google:     CLASSIFIER_PROVIDER=google     CLASSIFIER_MODEL=gemini-2.5-flash  CLASSIFIER_API_KEY=...
#   Ollama:     CLASSIFIER_PROVIDER=openai_compatible  CLASSIFIER_MODEL=llama3.1
#               CLASSIFIER_BASE_URL=http://localhost:11434/v1

# --- Custom policies (optional; worker only) ---
# Plain-language policies are checked by a language model. With POLICY_PROVIDER unset the
# CLASSIFIER_* model and key are reused; POLICY_PROVIDER=none turns policy checks off.
# Provider: openai | google | openai_compatible | none.
# POLICY_PROVIDER=
# POLICY_MODEL=
# Secret; prefer POLICY_API_KEY_FILE. Not needed for a keyless openai_compatible endpoint.
# POLICY_API_KEY=dev-only-replace-with-your-provider-key
# Required for openai_compatible; https unless loopback or POLICY_ALLOW_HTTP=true.
# POLICY_BASE_URL=
# POLICY_ALLOW_HTTP=false
# POLICY_TIMEOUT_MS=15000                # 1000..25000, per provider call
# POLICY_BRAND_MAX_IN_FLIGHT=2           # 1..16 concurrent provider calls per brand
# POLICY_MAX_WAIT_MINUTES=60             # 1..240, queue wait after which a comment is flagged for review
# POLICY_MONTHLY_CALLS_PER_BRAND=20000   # 0..10000000 provider calls per brand per month

# --- Observability (all optional; defaults shown; see docs/operations/observability.md) ---
# Logs are JSON lines on stdout. LOG_LEVEL above is debug | info | warn | error.
# Traces: off unless the exporter is otlp. No network traffic when none.
# OTEL_TRACES_EXPORTER=none
# OTLP collector base URL. Never put credentials in the URL; startup rejects them.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers, e.g. authorization=Bearer <token>. Secret; prefer a file or secret store.
# Not forwarded by compose.yaml; set it in a compose.override.yaml or the container environment.
# OTEL_EXPORTER_OTLP_HEADERS=
# Not forwarded by compose.yaml (set in compose.override.yaml or the container environment):
# OTEL_SERVICE_NAME=feedbouncer-api   # default feedbouncer-api or feedbouncer-worker
# OTEL_SDK_DISABLED=false             # true forces trace export off
# Prometheus /metrics: api 9464, worker 9465 (0 disables). Unauthenticated: keep it private.
# The process default is 127.0.0.1; compose.yaml sets 0.0.0.0 inside the containers and
# publishes nothing, so only containers on the compose network can reach it.
# METRICS_HOST=127.0.0.1
# METRICS_PORT is not forwarded by compose.yaml (set it in compose.override.yaml).
# METRICS_PORT=9464
# Not forwarded by compose.yaml (set in the container environment or compose.override.yaml):
# METRICS_MAX_CONNECTIONS=1000          # cap on per-connection series (1..100000)
# TELEMETRY_SHUTDOWN_TIMEOUT_MS=5000    # max wait to flush telemetry on shutdown (100..30000)
# CONNECTOR_STALE_AFTER_SECONDS=3600    # no sync for this long = degraded (60..2592000)
# CONNECTOR_STALE_AFTER_SECONDS_<PLATFORM>=  # per-platform override, e.g. _FACEBOOK
# CONNECTOR_LAG_DEGRADED_SECONDS=900    # oldest queued job age = degraded (60..604800)
# CONNECTOR_FAILURES_DEGRADED=3         # consecutive failures = degraded (1..100)

# --- Optional ---
# Publish Postgres and Redis on 127.0.0.1 (for psql, GUI clients, integration tests).
# Linux/macOS/WSL2 separator is ":". Setting COMPOSE_FILE disables auto-loading
# compose.override.yaml; add it to the list if you use one.
# COMPOSE_FILE=compose.yaml:compose.expose-db.yaml
# Run two clones side by side: give each a different project name.
# COMPOSE_PROJECT_NAME=feedbouncer
# Poll interval (ms) for the web app's file watcher (Next.js Turbopack). Set it
# (e.g. 1000) if edits to apps/web/src aren't picked up; 0 uses native file events.
# It logs some harmless "watch error" lines for paths that don't exist.
# WEB_WATCH_POLL_MS=1000
