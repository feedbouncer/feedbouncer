# FeedBouncer local development stack.
#   cp .env.example .env   then   docker compose up
# DEVELOPMENT-ONLY VALUES. Never reuse them anywhere reachable from a network.
# Passwords must be URL-safe (letters, digits, - _ .) because they are
# embedded in connection URLs.

# --- Required credentials (compose refuses to start without them) ---
POSTGRES_USER=feedbouncer
POSTGRES_PASSWORD=dev-only-postgres-password
POSTGRES_DB=feedbouncer
REDIS_PASSWORD=dev-only-redis-password
# Signs session cookies. At least 32 characters. Generate one with: openssl rand -base64 48
AUTH_SECRET=dev-only-auth-secret-change-me-0123456789
# Encrypts stored platform tokens. DEVELOPMENT-ONLY example key: production refuses it.
# Format: <key-id>:<base64 of 32 random bytes>[,<key-id>:<base64>...]. Generate: pnpm secrets keygen
# Rotation and backup: docs/operations/secrets.md. Back keys up SEPARATELY from database backups.
FB_ENCRYPTION_KEYS=dev-example:RiOYH93nnaej+o4hWDiBb6XqRseP2Fv5uDL8wejvLwY=
# The one key used for new encryption; every key listed above can still decrypt.
FB_ENCRYPTION_ACTIVE_KEY_ID=dev-example

# --- Environment ---
# development | test | production. Unset means production (strict: placeholders refused).
FB_ENV=development

# --- Secret files (containers) ---
# Any of DATABASE_URL, REDIS_URL, AUTH_SECRET, SMTP_URL, FB_ENCRYPTION_KEYS can instead be
# read from a mounted file by setting <NAME>_FILE to its absolute path (not both).
# AUTH_SECRET_FILE=/run/secrets/auth_secret
# FB_ENCRYPTION_KEYS_FILE=/run/secrets/fb_encryption_keys

# --- Set by compose.yaml for the local stack; set them yourself elsewhere ---
# DATABASE_URL=postgresql://user:password@host:5432/db
# REDIS_URL=redis://:password@host:6379/0
# SMTP_URL=smtp://host:25
# PUBLIC_WEB_URL=https://app.example.com
# TRUST_PROXY_HOPS=1
# PORT=3001
# HEALTH_PORT=3002
# MAIL_FROM=FeedBouncer <no-reply@example.com>

# --- Host ports (change these if something on your machine already uses them) ---
WEB_HOST_PORT=3000
API_HOST_PORT=3001
# Only used with compose.expose-db.yaml (see below).
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379
# Dev mail inbox: http://127.0.0.1:8025
MAILPIT_UI_HOST_PORT=8025

# Interface web and API bind to on the host. Keep 127.0.0.1 unless you
# deliberately want other machines on your network to reach the stack.
FB_BIND_ADDRESS=127.0.0.1

# --- App settings ---
LOG_LEVEL=info
WORKER_CONCURRENCY=4

# --- Job queue (all optional; defaults shown; see docs/operations/job-queue.md) ---
# JOB_QUEUE_PREFIX=fb
# JOB_CONCURRENCY=2
# Per-platform override: JOB_CONCURRENCY_<PLATFORM> (e.g. JOB_CONCURRENCY_FACEBOOK); 0 turns that
# platform's consumer off. Not forwarded by compose.yaml; set it in the container environment.
# JOB_MAX_ATTEMPTS=8
# JOB_BACKOFF_BASE_MS=5000
# JOB_BACKOFF_MAX_MS=900000
# JOB_DLQ_RETENTION_DAYS=14
# JOB_DEDUP_WINDOW_DAYS=30

# --- Observability (all optional; defaults shown; see docs/operations/observability.md) ---
# Logs are JSON lines on stdout. LOG_LEVEL above is debug | info | warn | error.
# Traces: off unless the exporter is otlp. No network traffic when none.
# OTEL_TRACES_EXPORTER=none
# OTLP collector base URL. Never put credentials in the URL; startup rejects them.
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTLP headers, e.g. authorization=Bearer <token>. Secret; prefer a file or secret store.
# Not forwarded by compose.yaml; set it in a compose.override.yaml or the container environment.
# OTEL_EXPORTER_OTLP_HEADERS=
# Not forwarded by compose.yaml (set in compose.override.yaml or the container environment):
# OTEL_SERVICE_NAME=feedbouncer-api   # default feedbouncer-api or feedbouncer-worker
# OTEL_SDK_DISABLED=false             # true forces trace export off
# Prometheus /metrics: api 9464, worker 9465 (0 disables). Unauthenticated: keep it private.
# The process default is 127.0.0.1; compose.yaml sets 0.0.0.0 inside the containers and
# publishes nothing, so only containers on the compose network can reach it.
# METRICS_HOST=127.0.0.1
# METRICS_PORT is not forwarded by compose.yaml (set it in compose.override.yaml).
# METRICS_PORT=9464
# Not forwarded by compose.yaml (set in the container environment or compose.override.yaml):
# METRICS_MAX_CONNECTIONS=1000          # cap on per-connection series (1..100000)
# TELEMETRY_SHUTDOWN_TIMEOUT_MS=5000    # max wait to flush telemetry on shutdown (100..30000)
# CONNECTOR_STALE_AFTER_SECONDS=3600    # no sync for this long = degraded (60..2592000)
# CONNECTOR_STALE_AFTER_SECONDS_<PLATFORM>=  # per-platform override, e.g. _FACEBOOK
# CONNECTOR_LAG_DEGRADED_SECONDS=900    # oldest queued job age = degraded (60..604800)
# CONNECTOR_FAILURES_DEGRADED=3         # consecutive failures = degraded (1..100)
# CONNECTOR_FIRST_SYNC_GRACE_SECONDS=3600  # pending first sync becomes degraded after this (60..604800)

# --- Optional ---
# Publish Postgres and Redis on 127.0.0.1 (for psql, GUI clients, integration tests).
# Linux/macOS/WSL2 separator is ":". Setting COMPOSE_FILE disables auto-loading
# compose.override.yaml; add it to the list if you use one.
# COMPOSE_FILE=compose.yaml:compose.expose-db.yaml
# Run two clones side by side: give each a different project name.
# COMPOSE_PROJECT_NAME=feedbouncer
# Poll interval (ms) for the web app's file watcher (Next.js Turbopack). Set it
# (e.g. 1000) if edits to apps/web/src aren't picked up; 0 uses native file events.
# It logs some harmless "watch error" lines for paths that don't exist.
# WEB_WATCH_POLL_MS=1000
