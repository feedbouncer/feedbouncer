{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "tsconfig.base.json",
    "eslint.config.base.mjs",
    ".prettierrc.json",
    ".prettierignore",
    ".nvmrc"
  ],
  "globalPassThroughEnv": [
    "DATABASE_URL",
    "REDIS_URL",
    "PORT",
    "HEALTH_PORT",
    "LOG_LEVEL",
    "WORKER_CONCURRENCY",
    "API_INTERNAL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "format": {
      "cache": false,
      "outputs": []
    },
    "format:check": {
      "outputs": []
    }
  }
}
