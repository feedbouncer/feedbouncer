{
  "rules": {
    "conditions": [
      {
        "type": "keyword",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "keyword"
            },
            "terms": {
              "maxItems": 5000,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "match": {
              "default": "whole_word",
              "type": "string",
              "enum": [
                "whole_word",
                "contains"
              ]
            }
          },
          "required": [
            "type",
            "terms"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "regex",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "regex"
            },
            "patterns": {
              "maxItems": 20,
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "type",
            "patterns"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "link_domain",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "link_domain"
            },
            "mode": {
              "type": "string",
              "enum": [
                "blocklist",
                "allowlist"
              ]
            },
            "domains": {
              "maxItems": 1000,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048
              }
            },
            "exemptOwnDomains": {
              "default": true,
              "type": "boolean"
            },
            "shorteners": {
              "default": "match",
              "type": "string",
              "enum": [
                "match",
                "ignore"
              ]
            },
            "lookalikes": {
              "default": "match",
              "type": "string",
              "enum": [
                "match",
                "ignore"
              ]
            }
          },
          "required": [
            "type",
            "mode",
            "domains"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "emoji",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "emoji"
            },
            "emoji": {
              "maxItems": 200,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 64
              }
            },
            "maxCount": {
              "default": null,
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 500
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "emoji"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "author",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "author"
            },
            "list": {
              "type": "string",
              "enum": [
                "block",
                "allow",
                "trusted"
              ]
            },
            "platform": {
              "type": "string",
              "enum": [
                "facebook",
                "instagram",
                "tiktok",
                "youtube",
                "threads",
                "linkedin",
                "x",
                "bluesky",
                "meta_ads"
              ]
            },
            "entries": {
              "minItems": 1,
              "maxItems": 5000,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "externalId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 255
                  },
                  "handle": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "required": [
            "type",
            "list",
            "platform",
            "entries"
          ],
          "additionalProperties": false
        }
      },
      {
        "type": "competitor",
        "schema": {
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "competitor"
            },
            "names": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 200
              }
            },
            "handles": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "domains": {
              "maxItems": 500,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 2048
              }
            }
          },
          "required": [
            "type",
            "names",
            "handles",
            "domains"
          ],
          "additionalProperties": false
        }
      }
    ],
    "limits": {
      "terms": 5000,
      "termChars": 100,
      "patterns": 20,
      "domains": 1000,
      "emoji": 200,
      "maxCount": 500,
      "authorEntries": 5000,
      "idChars": 255,
      "handleChars": 100,
      "competitorEach": 500,
      "jsonChars": 600000,
      "termCharsBeforeTrim": 200
    },
    "modes": [
      "enforce",
      "suggest"
    ],
    "steps": [
      {
        "type": "flag_for_review",
        "order": 0,
        "reversible": true,
        "undo": "dismiss_review"
      },
      {
        "type": "private_reply",
        "order": 1,
        "reversible": false,
        "undo": "none"
      },
      {
        "type": "auto_reply",
        "order": 2,
        "reversible": false,
        "undo": "none"
      },
      {
        "type": "hide",
        "order": 3,
        "reversible": true,
        "undo": "unhide"
      },
      {
        "type": "ban",
        "order": 4,
        "reversible": false,
        "undo": "unban_author"
      },
      {
        "type": "delete",
        "order": 5,
        "reversible": false,
        "undo": "none"
      }
    ],
    "conflicts": [
      [
        "auto_reply",
        "hide"
      ],
      [
        "auto_reply",
        "delete"
      ],
      [
        "private_reply",
        "ban"
      ],
      [
        "hide",
        "delete"
      ]
    ],
    "outcomes": [
      "approve",
      "flag",
      "hide",
      "remove"
    ],
    "ruleBudgetMs": 50
  },
  "api": {
    "errors": [
      {
        "code": "invalid_request",
        "status": 400
      },
      {
        "code": "invalid_cursor",
        "status": 400
      },
      {
        "code": "unauthenticated",
        "status": 401
      },
      {
        "code": "insufficient_scope",
        "status": 403
      },
      {
        "code": "not_found",
        "status": 404
      },
      {
        "code": "rate_limited",
        "status": 429
      },
      {
        "code": "temporarily_unavailable",
        "status": 503
      },
      {
        "code": "internal_error",
        "status": 500
      },
      {
        "code": "idempotency_key_reused",
        "status": 422
      },
      {
        "code": "idempotency_request_in_progress",
        "status": 409
      },
      {
        "code": "invalid_idempotency_key",
        "status": 400
      },
      {
        "code": "connection_inactive",
        "status": 409
      },
      {
        "code": "unsupported_action",
        "status": 422
      },
      {
        "code": "invalid_webhook_url",
        "status": 422
      },
      {
        "code": "webhook_endpoint_limit_reached",
        "status": 409
      },
      {
        "code": "webhook_endpoint_disabled",
        "status": 409
      },
      {
        "code": "webhook_event_unavailable",
        "status": 409
      },
      {
        "code": "webhook_delivery_in_progress",
        "status": 409
      },
      {
        "code": "text_too_long",
        "status": 422
      },
      {
        "code": "reply_not_allowed",
        "status": 422
      },
      {
        "code": "rule_rejected",
        "status": 422
      },
      {
        "code": "rule_limit_reached",
        "status": 409
      },
      {
        "code": "pending_limit_reached",
        "status": 409
      }
    ],
    "scopes": [
      "moderate",
      "read",
      "write"
    ],
    "page": {
      "default": 50,
      "max": 100
    },
    "rateLimit": {
      "defaultPerMinute": 60,
      "authFailuresPerMinute": 30,
      "env": "PUBLIC_API_RATE_LIMIT_PER_MINUTE"
    },
    "idempotencyKeyTtlHours": 24,
    "requestBodyLimitBytes": 65536
  },
  "moderationCheck": {
    "reasons": [
      "rule_matched",
      "classifier_threshold",
      "policy_matched",
      "no_match",
      "classifier_unavailable",
      "classifier_not_configured",
      "policy_unavailable"
    ]
  }
}
