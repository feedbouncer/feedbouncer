        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "reply_to_comment",
      "title": "Reply to comment",
      "description": "Posts a public reply as the brand under a comment. Acts on the live social platform. Retrying with the same text never posts twice.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "commentId": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "ID of the comment to reply to (from list_inbox)."
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8000,
            "description": "Reply text, posted publicly as the brand."
          },
          "idempotencyKey": {
            "description": "Optional retry key; reuse it to make a retried call safe.",
            "type": "string",
            "pattern": "^[A-Za-z0-9._:-]{1,64}$"
          }
        },
        "required": [
          "commentId",
          "text"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema"
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "posted",
              "queued"
            ]
          },
          "actionId": {
            "type": "string"
          },
          "replyId": {
            "type": "string"
          }
        },
        "required": [
          "status",
          "actionId"
        ],
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "search_inbox",
      "title": "Search inbox",
      "description": "Read-only. Searches comment text in the FeedBouncer inbox, with the same filters and paging as list_inbox.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "brandId": {
            "description": "Only comments for this brand.",
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "visible",
              "hidden",
              "replied",
              "unanswered",
              "flagged"
            ]
          },
          "platform": {
            "type": "string",
            "enum": [
              "facebook",
              "instagram"
            ]
          },
          "from": {
            "description": "Posted at or after this ISO 8601 time (with offset).",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "to": {
            "description": "Posted before this ISO 8601 time (with offset).",
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
          },
          "limit": {
            "default": 20,
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "cursor": {
            "description": "nextCursor from a previous page.",
            "type": "string",
            "maxLength": 512
          },
          "query": {
            "type": "string",
            "minLength": 2,
            "maxLength": 200,
            "description": "Words to search for in comment text."
          }
        },
        "required": [
