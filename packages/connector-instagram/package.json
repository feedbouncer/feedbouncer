{
  "name": "@feedbouncer/connector-instagram",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@feedbouncer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run"
  },
  "dependencies": {
    "@feedbouncer/connector-facebook": "workspace:*",
    "@feedbouncer/connectors": "workspace:*",
    "@feedbouncer/service-runtime": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6"
  }
}
