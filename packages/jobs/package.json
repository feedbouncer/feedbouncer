{
  "name": "@feedbouncer/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@feedbouncer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@feedbouncer/source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "cli": "tsc --build tsconfig.build.json && node dist/bin.js"
  },
  "dependencies": {
    "@feedbouncer/connectors": "workspace:*",
    "@feedbouncer/db": "workspace:*",
    "@feedbouncer/secrets": "workspace:*",
    "@feedbouncer/service-runtime": "workspace:*",
    "@opentelemetry/api": "1.9.1",
    "bullmq": "6.3.12",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@opentelemetry/context-async-hooks": "2.12.0",
    "@opentelemetry/core": "2.12.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1"
  }
}
