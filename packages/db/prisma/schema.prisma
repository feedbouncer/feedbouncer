// SQL-first: the schema is defined ONLY by prisma/migrations/*/migration.sql
// (reversed by down.sql). Prisma Migrate is used as the runner (deploy, status,
// resolve). Do not add models here and never run `prisma migrate dev`, `migrate
// reset` or `db push`: with no models they would generate DROPs for every table.
// A future ticket adopting Prisma Client should introspect with `prisma db pull`.
// See packages/db/README.md.
datasource db {
  provider = "postgresql"
}
