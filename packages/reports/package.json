{
  "name": "@feedbouncer/reports",
  "license": "AGPL-3.0-only",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "@feedbouncer/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "@feedbouncer/source": "./src/testing.ts",
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc --build tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../../.prettierignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path ../../.prettierignore --ignore-unknown",
    "typecheck": "tsc --noEmit --tsBuildInfoFile node_modules/.cache/typecheck.tsbuildinfo",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@feedbouncer/actions": "workspace:*",
    "@feedbouncer/classifier": "workspace:*",
    "@feedbouncer/db": "workspace:*",
    "pg": "8.23.1"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1"
  }
}
